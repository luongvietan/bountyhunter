{
  "name": "kritt-radar",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "migrate": "pnpm --filter @kritt-radar/db run migrate",
    "collect": "pnpm --filter @kritt-radar/worker run cli collect",
    "materialize": "pnpm --filter @kritt-radar/worker run cli materialize",
    "rank": "pnpm --filter @kritt-radar/worker run cli rank"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
