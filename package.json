{
  "name": "kritt-radar",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "migrate": "pnpm --filter @kritt-radar/db run migrate",
    "collect-catalog": "pnpm --filter @kritt-radar/worker run cli collect-catalog",
    "materialize-catalog": "pnpm --filter @kritt-radar/worker run cli materialize-catalog",
    "collect-github": "pnpm --filter @kritt-radar/worker run cli collect-github",
    "materialize-signals": "pnpm --filter @kritt-radar/worker run cli materialize-signals",
    "sync": "pnpm build && pnpm --filter @kritt-radar/worker run cli sync",
    "collect": "pnpm --filter @kritt-radar/worker run cli collect",
    "materialize": "pnpm --filter @kritt-radar/worker run cli materialize",
    "rank": "pnpm --filter @kritt-radar/worker run cli rank",
    "test:e2e": "pnpm --filter @kritt-radar/web run test:e2e",
    "provision": "pnpm --filter @kritt-radar/worker run cli provision",
    "automate": "pnpm --filter @kritt-radar/worker... build && pnpm --filter @kritt-radar/worker run cli automate",
    "automate:fast": "pnpm --filter @kritt-radar/worker run cli automate -- --fast",
    "dispatch": "pnpm --filter @kritt-radar/worker run cli dispatch",
    "ingest": "pnpm --filter @kritt-radar/worker run cli ingest",
    "watch": "pnpm --filter @kritt-radar/worker run cli watch"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
