# Automation (A–Z pipeline)

# Run the full daily pipeline: sync → auto-merge → dispatch → watch
RADAR_AUTOMATE_DISPATCH=true
# Fast mode: skip catalog/github sync, single ingest (pnpm automate:fast or --fast)
RADAR_AUTOMATE_FAST=false
# Milliseconds before watch exits during automate (default 25 minutes)
RADAR_AUTOMATE_WATCH_TIMEOUT_MS=1500000
# Log decisions without writing merge/triage/dispatch mutations
RADAR_AUTOMATE_DRY_RUN=false

# Auto-merge pending entity candidates
RADAR_AUTO_MERGE=true
RADAR_AUTO_MERGE_MIN=0.92
RADAR_AUTO_MERGE_AI_MIN=0.85
RADAR_AUTO_MERGE_AI_CONFIDENCE=0.85

# Auto-dismiss findings after ingest (inScope/postScriptValid + Finding Triage)
RADAR_AUTO_TRIAGE=true

# LLM for borderline merge review (OpenAI-compatible chat completions)
RADAR_LLM_API_URL=
RADAR_LLM_API_KEY=
RADAR_LLM_MODEL=gpt-4o-mini

# Collected evidence. Production chạy trên Railway Postgres và đây là URL công
# khai của nó (thêm ?sslmode=require). Worker local, cron trên Railway, và
# dashboard trên Vercel đều trỏ vào cùng một database — không đồng bộ hai chiều.
# Giá trị dưới đây là Postgres local của docker-compose, chỉ dùng khi chạy tách
# rời hẳn khỏi cloud.
DATABASE_URL=postgresql://kritt:kritt@localhost:5433/kritt_radar

# Read-only, public repositories. Only lifts the GitHub rate limit from 60 to
# 5000 requests an hour; no scope beyond public read is needed or wanted.
GITHUB_TOKEN=

# Etherscan API V2 key used for source verification across supported EVM chains.
ETHERSCAN_API_KEY=

# Do not point this at kritt_radar_e2e. `pnpm test:e2e` recreates that database
# on every run and drops it on teardown, so a dev server aimed there loses its
# data mid-session and renders the "connect the evidence database" screen.

# Open-Kritt. The backend binds 127.0.0.1:3002 and ships with no application
# authentication, so never expose that port beyond loopback.
KRITT_API_URL=http://127.0.0.1:3002/api

# `pnpm provision` installs config/kritt/solidity-defi-workflow.json into Kritt
# and reports the ids. Dispatch then resolves the workflow and the post-script
# chain by name on every run, so these two only pin something else.
KRITT_WORKFLOW_ID=
KRITT_POST_SCRIPT_ID=

# The workflow dispatch looks up when KRITT_WORKFLOW_ID is empty. Kritt's own
# external-flow-analysis is the wrong tool for a Solidity target: it spends the
# budget on browser and postMessage surfaces no smart-contract program pays for.
KRITT_WORKFLOW_NAME=Solidity DeFi Value Flow

# Post-scripts to run on every finding, in order. Build the proof, write the
# report around it, check attacker eligibility, then triage noise for automation.
KRITT_POST_SCRIPT_CHAIN=PoC Creator,Report Creator,Is Malicious Actor in scope,Finding Triage

# Model selection Open-Kritt requires on every scan create. Defaults match the
# Codex catalog shipped with a local install; override when Accounts changes.
KRITT_MODEL=gpt-5.6-sol
KRITT_HARNESS=codex
KRITT_MODEL_PROVIDER=codex
KRITT_THINKING_EFFORT=medium
# Optional. When empty, dispatch loads the default severity ranker from Kritt.
KRITT_SEVERITY_RANKER_ID=
KRITT_SEVERITY_RANKER=

# Scans run one at a time in Kritt, so three is roughly a day of queue and a
# misconfigured run cannot empty a budget.
KRITT_MAX_SCANS=3
KRITT_SCOPE_FILE_LIMIT=40

# Optional fallback provider for the second auto-retry after a failed scan.
KRITT_FALLBACK_MODEL=
KRITT_FALLBACK_HARNESS=
KRITT_FALLBACK_MODEL_PROVIDER=
KRITT_FALLBACK_THINKING_EFFORT=

# Poll interval for `pnpm watch` / `pnpm ingest --watch` while scans run.
KRITT_WATCH_INTERVAL_MS=30000
